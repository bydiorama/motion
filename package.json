{
  "name": "@bydiorama/motion",
  "version": "0.4.0",
  "license": "MIT",
  "description": "Diorama motion library: films as data, written by agents, directed by people.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bydiorama/motion.git"
  },
  "homepage": "https://github.com/bydiorama/motion#readme",
  "bugs": "https://github.com/bydiorama/motion/issues",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "motion": "./dist/npm/cli/motion.js"
  },
  "exports": {
    ".": {
      "types": "./dist/npm/index.d.ts",
      "import": "./dist/npm/index.js"
    },
    "./build": {
      "types": "./dist/npm/build/index.d.ts",
      "import": "./dist/npm/build/index.js"
    },
    "./film.schema.json": "./schema/film.schema.json"
  },
  "scripts": {
    "motion": "node bin/motion.mjs",
    "build": "node bin/motion.mjs bundle",
    "catalog": "node bin/motion.mjs catalog --write",
    "test": "node --test \"src/**/*.test.ts\"",
    "type-check": "tsc --noEmit",
    "verify": "pnpm run type-check && pnpm run test && node bin/motion.mjs catalog --check && node bin/motion.mjs validate films/*.film.json",
    "prepack": "npm run build:package",
    "build:package": "node scripts/build-package.mjs"
  },
  "dependencies": {
    "dialkit": "2.1.0",
    "esbuild": "0.28.1",
    "playwright": "1.62.1",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/npm",
    "library",
    "library.json",
    "catalog.json",
    "schema/film.schema.json",
    "examples/builder.film.mjs",
    "films/feature-announcement.film.json",
    "CREDITS.md",
    "showcase/vendor/DIALKIT-LICENSE",
    "src/studio/theme/fonts/OFL.txt"
  ]
}
