{
  "$schema": "../schema/film.schema.json",
  "motion": "0.5",
  "title": "Signal reel: depth, camera and light",
  "size": [1080, 1350],
  "fps": 60,
  "poster": 2.6,
  "seed": 7,
  "theme": { "scheme": "dark", "accent": "#3D6BFF" },
  "tokens": { "hold": 0.6 },
  "scenes": [
    {
      "id": "noise",
      "intent": "The film does what it says: static settles into a calm grid while the line fills.",
      "background": "#08090B",
      "layout": { "padding": 96 },
      "layers": [
        { "id": "field", "use": "texture/signal-field", "enter": { "move": "fade", "duration": 0.8, "ease": "smooth" } },
        { "id": "line", "use": "type/fill-text", "at": 0.3, "props": { "text": "Motion that turns noise into a clear signal.", "accent": ["signal"] }, "params": { "duration": 1.7 }, "style": { "size": "headline", "weight": 450, "css": { "font-size": "calc(var(--m-u) * 7.4)", "line-height": "1.12" } } }
      ],
      "hold": 1.4,
      "tracks": { "scale": [[0, 1.04], [3.6, 1, "linear"]] },
      "out": { "use": "transition/dive-in", "duration": 0.9, "params": { "pace": "glide", "scale_to": 4, "y": 52 } }
    },
    {
      "id": "window",
      "intent": "A page turns into perspective and lifts the one part that matters.",
      "background": "#08090B",
      "layout": { "gap": 72, "padding": 80 },
      "layers": [
        { "id": "caption", "use": "type/mask-reveal", "at": 0.5, "props": { "text": "Every part lifts\nfrom its own page.", "accent": ["lifts"] }, "style": { "size": "headline", "weight": 450 } },
        { "id": "browser", "use": "rig/browser-window", "props": { "url": "signal.example", "lift": [36, 54, 28, 38] }, "params": { "width": 92, "aspect": 0.75, "tilt": -26, "pitch": 12, "move": 1.1, "lift": 150 } }
      ],
      "hold": 2.2,
      "out": { "use": "transition/camera-travel", "duration": 1.45, "params": { "direction": "down", "pull": 0.34, "tilt": 16 } }
    },
    {
      "id": "features",
      "intent": "The camera lands on the features at an angle, tabs stepped like stairs; the open tab slides through them as the view turns square.",
      "background": "#0C0D10",
      "layout": { "gap": 64, "padding": 80 },
      "layers": [
        { "id": "caption", "use": "type/fill-text", "at": 0.2, "props": { "text": "Six capabilities.\nOne open at a time.", "accent": ["open"] }, "params": { "duration": 1.2 }, "style": { "size": "title", "weight": 450, "css": { "font-size": "calc(var(--m-u) * 5)", "line-height": "1.15" } } },
        { "id": "tabs", "use": "rig/tab-stack", "props": { "items": ["Monitoring", "Detection", "Narrative mapping", "Source tracing", "Alerts", "Reporting"], "details": ["Every channel, watched continuously.", "Unusual activity, flagged the moment it starts.", "How a story spreads, and who carries it.", "Where it began, account by account.", "The right people, told at the right time.", "A brief that is ready when you are: what happened, where it came from and what to do next."] }, "params": { "width": 84, "path": "out", "tilt": -20, "pitch": 14, "roll": -1.5, "zoom": 0.88, "move": 1.7, "slide_at": 0.9, "slide": 1.8, "stack": 30, "pop": 50 } }
      ],
      "hold": 1.3,
      "out": { "use": "transition/whip-pan", "params": { "direction": "left" } }
    },
    {
      "id": "world",
      "intent": "A chip brakes in with motion blur along its path: sharp the moment it stops.",
      "background": "#0C0D10",
      "layout": { "gap": 56, "padding": 96 },
      "layers": [
        { "id": "ground", "use": "fx/grid-ripple", "params": { "cols": 18, "opacity": 0.25, "pulse": 0.2 } },
        { "id": "chip", "use": "el/text", "at": 0.15, "props": { "text": "MOTION BLUR" }, "style": { "size": "caption", "font": "mono", "color": "accent" }, "enter": { "move": "slide-left", "amount": 900, "duration": 0.7, "ease": "expo.out" }, "motionBlur": true },
        { "id": "line", "use": "type/fill-text", "at": 0.35, "props": { "text": "Blur follows speed,\nalong the path only.", "accent": ["speed"] }, "params": { "duration": 1.5 }, "style": { "size": "headline", "weight": 450 } }
      ],
      "hold": 1.2,
      "out": { "use": "transition/push", "params": { "direction": "up" } }
    },
    {
      "id": "places",
      "intent": "Events found where they start: markers land, ripple together, raise their cards.",
      "background": "#08090B",
      "layout": { "justify": "start", "padding": 96 },
      "layers": [
        { "id": "ground", "use": "fx/grid-ripple", "params": { "cols": 30, "size": 0.16, "opacity": 0.3, "pulse": 0.15 } },
        { "id": "title", "use": "type/mask-reveal", "at": 0.1, "props": { "text": "Signals, found\nwhere they start." }, "style": { "size": "headline", "weight": 450 } },
        { "id": "pins", "use": "fx/pin-drop", "at": 0.5, "props": { "points": [30, 70, 66, 52, 54, 82], "labels": ["Spike in mentions", "New narrative", "Coordinated accounts"] } }
      ],
      "hold": 1.4,
      "out": { "use": "transition/signal-wipe" }
    },
    {
      "id": "tiles",
      "intent": "Panels in depth come apart and fly out past the camera, front first.",
      "background": "#08090B",
      "layers": [
        { "id": "back-a", "use": "el/box", "props": { "fill": "#1A1D24" }, "params": { "width": 520, "height": 340, "radius": 22 }, "place": { "x": 30, "y": 26 }, "enter": "focus" },
        { "id": "back-b", "use": "el/box", "props": { "fill": "#1A1D24" }, "params": { "width": 520, "height": 340, "radius": 22 }, "place": { "x": 72, "y": 74 }, "at": 0.1, "enter": "focus" },
        { "id": "mid", "use": "el/box", "props": { "fill": "#23262D" }, "params": { "width": 560, "height": 360, "radius": 22 }, "place": { "x": 68, "y": 30 }, "at": 0.2, "enter": "focus" },
        { "id": "front", "use": "el/box", "props": { "fill": "accent" }, "params": { "width": 640, "height": 400, "radius": 24 }, "place": { "x": 44, "y": 56 }, "at": 0.3, "enter": "zoom" },
        { "id": "label", "use": "type/mask-reveal", "at": 0.6, "props": { "text": "Out of the way." }, "style": { "size": "title", "color": "on-accent" }, "place": { "x": 44, "y": 56 } }
      ],
      "hold": 0.8,
      "out": { "use": "transition/fly-past" }
    },
    {
      "id": "end",
      "intent": "The lockup alone, at rest: the poster.",
      "background": "#08090B",
      "layers": [
        { "id": "logo", "use": "scene/logo-reveal", "at": 0.3, "props": { "name": "bydiorama" }, "style": { "size": "headline" } },
        { "id": "grain", "use": "texture/grain", "params": { "amount": 0.05 } }
      ],
      "hold": "$hold_end"
    }
  ]
}
