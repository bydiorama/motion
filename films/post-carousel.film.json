{
  "motion": "0.4.0",
  "title": "Post carousel",
  "size": [
    1080,
    1350
  ],
  "fps": 30,
  "poster": 0.5,
  "theme": {
    "scheme": "dark",
    "accent": "#FF4D5E"
  },
  "scenes": [
    {
      "id": "post",
      "intent": "A carousel post read slide by slide, the next one always waiting beside it.",
      "background": "#14161C",
      "layout": {
        "padding": 0,
        "justify": "center"
      },
      "hold": 0.6,
      "out": {
        "use": "transition/push",
        "duration": 0.7
      },
      "layers": [
        {
          "id": "post",
          "use": "scene/post-carousel",
          "props": {
            "slides": [
              "<div style=\"width:100%;height:100%;box-sizing:border-box;padding:7% 8%;background:#D7F25C;color:#14161C;display:flex;flex-direction:column;justify-content:space-between;font-family:var(--m-font-body)\"><span style=\"font:500 0.5em/1.3 var(--m-font-body);opacity:.75\">Case study</span><span style=\"font:600 1.9em/1.02 var(--m-font-display);letter-spacing:-0.02em\">Data, finally<br>in one place</span><span style=\"font:500 0.5em/1.3 var(--m-font-body);opacity:.75\">Swipe →</span></div>",
              "<img src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20800%201000%22%20width%3D%22800%22%20height%3D%221000%22%3E%3Crect%20width%3D%22800%22%20height%3D%221000%22%20fill%3D%22%232C47D9%22%2F%3E%3Ccircle%20cx%3D%22400%22%20cy%3D%22420%22%20r%3D%22230%22%20fill%3D%22%23D7F25C%22%2F%3E%3Crect%20x%3D%22170%22%20y%3D%22640%22%20width%3D%22460%22%20height%3D%22230%22%20rx%3D%2230%22%20fill%3D%22%2314161C%22%2F%3E%3C%2Fsvg%3E\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover\">",
              "<div style=\"width:100%;height:100%;box-sizing:border-box;padding:7% 8%;background:#ECE9E2;color:#14161C;display:flex;flex-direction:column;justify-content:space-between;font-family:var(--m-font-body)\"><span style=\"font:600 0.9em/1.02 var(--m-font-display);letter-spacing:-0.02em\">The team reduced reporting time by</span><span style=\"font:600 3.6em/1.02 var(--m-font-display);letter-spacing:-0.02em\">180%</span></div>",
              "<div style=\"width:100%;height:100%;box-sizing:border-box;padding:7% 8%;background:#14161C;color:#ECE9E2;display:flex;flex-direction:column;justify-content:space-between;font-family:var(--m-font-body)\"><span style=\"font:600 1.05em/1.02 var(--m-font-display);letter-spacing:-0.02em\">“It replaced four tools and a weekly spreadsheet.”</span><span style=\"font:500 0.5em/1.3 var(--m-font-body);opacity:.75\">Head of operations</span></div>",
              "<img src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20800%201000%22%20width%3D%22800%22%20height%3D%221000%22%3E%3Crect%20width%3D%22800%22%20height%3D%221000%22%20fill%3D%22%23B8B8B4%22%2F%3E%3Crect%20x%3D%220%22%20y%3D%22640%22%20width%3D%22800%22%20height%3D%22360%22%20fill%3D%22%238E8E8A%22%2F%3E%3Crect%20x%3D%22140%22%20y%3D%22250%22%20width%3D%22240%22%20height%3D%22420%22%20rx%3D%2216%22%20fill%3D%22%23ECE9E2%22%2F%3E%3Crect%20x%3D%22420%22%20y%3D%22360%22%20width%3D%22240%22%20height%3D%22310%22%20rx%3D%2216%22%20fill%3D%22%2314161C%22%2F%3E%3C%2Fsvg%3E\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover\">"
            ],
            "handle": "northwind.data"
          },
          "params": {
            "width": 56,
            "ratio": "4:5",
            "chrome": "post",
            "hold": 1.4,
            "turn": 0.8,
            "angle": 72
          }
        }
      ]
    },
